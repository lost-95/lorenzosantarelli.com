// Cloudflare Worker for lorenzosantarelli.com.
// Every push to `main` is built (`npm run build`) and deployed (`npx wrangler deploy`)
// by Cloudflare Workers Builds.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lorenzosantarelli-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router: unknown paths get index.html
    "not_found_handling": "single-page-application",
    // these paths are handled by worker/index.js before looking at the static files
    "run_worker_first": ["/f1-predictor", "/f1-predictor/*"]
  },
  "observability": { "enabled": true }
}
